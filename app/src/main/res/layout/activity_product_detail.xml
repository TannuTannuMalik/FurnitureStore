<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productDetailLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    tools:context=".customer.ProductDetailActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:background="@color/forest_green"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/backIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white"
            android:contentDescription="Back Icon"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/homeIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_home"
            app:tint="@android:color/white"
            android:layout_marginStart="12dp"
            android:contentDescription="Home Icon"
            android:padding="8dp" />

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RECOZY"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:gravity="center" />

        <!-- Cart icon first -->
        <ImageView
            android:id="@+id/cartIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_cart"
            app:tint="@android:color/white"
            android:contentDescription="Cart Icon"
            android:padding="8dp" />

        <!-- Profile icon second -->
        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_profile"
            app:tint="@android:color/white"
            android:layout_marginEnd="12dp"
            android:contentDescription="Profile Icon"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Product Image -->
    <ImageView
        android:id="@+id/imageViewProductDetail"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_below="@id/topBar"
        android:scaleType="centerCrop"
        android:contentDescription="Product Image" />

    <!-- Product Name -->
    <TextView
        android:id="@+id/textViewProductNameDetail"
        android:layout_below="@id/imageViewProductDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/forest_green"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true" />

    <!-- Product Category -->
    <TextView
        android:id="@+id/textViewProductCategoryDetail"
        android:layout_below="@id/textViewProductNameDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp"
        android:layout_centerHorizontal="true" />

    <!-- Product Price -->
    <TextView
        android:id="@+id/textViewProductPriceDetail"
        android:layout_below="@id/textViewProductCategoryDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true" />

    <!-- Description -->
    <TextView
        android:id="@+id/textViewProductDescriptionDetail"
        android:layout_below="@id/textViewProductPriceDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:textSize="16sp" />

    <!-- Quantity Layout -->
    <LinearLayout
        android:id="@+id/quantityLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewProductDescriptionDetail"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewQuantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/buttonDecrease"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/forest_green"
            android:padding="0dp" />

        <TextView
            android:id="@+id/textViewQuantityValue"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonIncrease"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/forest_green"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Add to Cart Button -->
    <Button
        android:id="@+id/buttonAddToCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add to Cart"
        android:layout_below="@id/quantityLayout"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        android:backgroundTint="@color/forest_green"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp" />

    <!-- Add to Wishlist Button -->
    <Button
        android:id="@+id/buttonAddToWishlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add to Wishlist"
        android:layout_below="@id/buttonAddToCart"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:backgroundTint="@color/forest_green"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp" />

    <!-- Terms -->
    <TextView
        android:id="@+id/textViewTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terms and Conditions"
        android:textColor="@android:color/holo_blue_dark"
        android:textStyle="bold"
        android:layout_below="@id/buttonAddToWishlist"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true" />

</RelativeLayout>
