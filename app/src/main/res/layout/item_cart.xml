<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Product Image -->
    <ImageView
        android:id="@+id/imageViewProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="Product Image"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Name -->
    <TextView
        android:id="@+id/textViewProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingStart="8dp"
        app:layout_constraintStart_toEndOf="@id/imageViewProduct"
        app:layout_constraintTop_toTopOf="@id/imageViewProduct"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Price -->
    <TextView
        android:id="@+id/textViewProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textSize="14sp"
        android:paddingTop="4dp"
        app:layout_constraintStart_toStartOf="@id/textViewProductName"
        app:layout_constraintTop_toBottomOf="@id/textViewProductName" />

    <!-- Quantity Label -->
    <TextView
        android:id="@+id/textViewQuantityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/textViewProductName"
        app:layout_constraintTop_toBottomOf="@id/textViewProductPrice" />

    <!-- Decrease Quantity Button -->
    <Button
        android:id="@+id/buttonDecrease"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="-"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#a5812a"
        android:padding="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewQuantityLabel"
        app:layout_constraintStart_toStartOf="@id/textViewQuantityLabel" />

    <!-- Quantity Text -->
    <TextView
        android:id="@+id/textViewQuantity"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:text="1"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@id/buttonDecrease"
        app:layout_constraintTop_toTopOf="@id/buttonDecrease"
        app:layout_constraintBottom_toBottomOf="@id/buttonDecrease"
        android:layout_marginStart="8dp" />

    <!-- Increase Quantity Button -->
    <Button
        android:id="@+id/buttonIncrease"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#a5812a"
        android:padding="0dp"
        app:layout_constraintStart_toEndOf="@id/textViewQuantity"
        app:layout_constraintTop_toTopOf="@id/buttonDecrease"
        app:layout_constraintBottom_toBottomOf="@id/buttonDecrease"
        android:layout_marginStart="8dp" />

    <!-- Remove Button -->
    <Button
        android:id="@+id/buttonRemove"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Remove"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:backgroundTint="#a5812a"
        app:layout_constraintStart_toEndOf="@id/buttonIncrease"
        app:layout_constraintTop_toTopOf="@id/buttonIncrease"
        app:layout_constraintBottom_toBottomOf="@id/buttonIncrease"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
