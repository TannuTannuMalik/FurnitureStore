<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".dashboard.SellerDashboardActivity">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/forest_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/buttonGoBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Seller Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Button
                android:id="@+id/buttonEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="#228B22"
                android:layout_marginTop="12dp"/>

            <!-- Buttons -->
            <Button
                android:id="@+id/buttonViewOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Orders"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/forest_green"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/buttonSellerRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View My Revenue"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/forest_green"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp" />
            <Button
                android:id="@+id/buttonManageProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Products"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/forest_green"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List your products here"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/forest_green"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <!-- Product Inputs -->
            <EditText
                android:id="@+id/editTextProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Product Name"
                android:padding="10dp"
                android:background="@drawable/edit_text_background" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/editTextPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Price"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_background" />

            <EditText
                android:id="@+id/editTextQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quantity"
                android:inputType="number"
                android:padding="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_background" />

            <EditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:hint="Description"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:scrollbars="vertical"
                android:padding="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_background" />

            <!-- Image Upload Buttons -->
            <Button
                android:id="@+id/buttonUploadMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Main Image"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/forest_green"
                android:textColor="#FFFFFF" />

            <ImageView
                android:id="@+id/imageMain"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:background="@android:color/darker_gray" />

            <Button
                android:id="@+id/buttonUploadSub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Sub Image 1"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/forest_green"
                android:textColor="#FFFFFF" />

            <ImageView
                android:id="@+id/imageSub1"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:background="@android:color/darker_gray" />

            <Button
                android:id="@+id/buttonUploadSub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Sub Image 2"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/forest_green"
                android:textColor="#FFFFFF" />

            <ImageView
                android:id="@+id/imageSub2"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:background="@android:color/darker_gray" />

            <!-- Add Product Button -->
            <Button
                android:id="@+id/buttonAddProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Add Product"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/forest_green" />

            <!-- RecyclerView for Product List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSeller"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
