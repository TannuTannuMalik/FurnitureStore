<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <!-- Header bar with back button and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="#228B22" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- You can keep cart or remove this if not needed -->
        <!-- Removed buttonCart as it was confusing logout with cart -->

    </LinearLayout>

    <!-- ScrollView for delivery details -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Details"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="20dp" />

            <!-- Name -->
            <EditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="textPersonName" />

            <!-- Phone -->
            <EditText
                android:id="@+id/editTextPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="phone" />

            <!-- Street -->
            <EditText
                android:id="@+id/editTextStreet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Street Address"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="textPostalAddress" />

            <!-- City -->
            <EditText
                android:id="@+id/editTextCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="City"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="textCapWords" />

            <!-- State -->
            <EditText
                android:id="@+id/editTextState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="State"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="textCapWords" />

            <!-- ZIP Code -->
            <EditText
                android:id="@+id/editTextZip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ZIP / Postal Code"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="24dp"
                android:inputType="number" />

            <!-- Place Order Button -->
            <Button
                android:id="@+id/buttonPlaceOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Place Order"
                android:backgroundTint="#A3B18A"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:padding="14dp"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Logout button at bottom -->
    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Logout"
        android:backgroundTint="#D9534F"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginTop="12dp" />

</LinearLayout>
