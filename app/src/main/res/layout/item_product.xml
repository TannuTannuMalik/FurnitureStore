<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="8dp"
    android:layout_margin="8dp"
    android:elevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Main large image -->
        <ImageView
            android:id="@+id/productImageMain"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:contentDescription="Main product image" />

        <!-- Two smaller sub-images side by side below the main image -->
        <LinearLayout
            android:id="@+id/subImagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/productImageMain"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="2">

            <ImageView
                android:id="@+id/productImageSub1"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:contentDescription="Sub image 1" />

            <ImageView
                android:id="@+id/productImageSub2"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:scaleType="centerCrop"
                android:contentDescription="Sub image 2" />
        </LinearLayout>


        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:text="Delete"
            android:padding="8dp"
            android:textColor="@android:color/holo_red_dark"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="visible" />

        <!-- Edit button -->
        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/buttonDelete"
            android:text="Edit"
            android:padding="8dp"
            android:textColor="@android:color/holo_blue_dark"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="visible" />

        <TextView
            android:id="@+id/productName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/subImagesContainer"
            android:text="Product Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/productCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/productName"
            android:text="Category"
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/productPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/productCategory"
            android:text="$0.00"
            android:textSize="14sp"
            android:textColor="#000000"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/productCreatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/productPrice"
            android:text="Created: 01 Jan 2023"
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/productQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/productCreatedAt"
            android:text="Stock: 0"
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingTop="4dp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>